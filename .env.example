# Copy to .env and fill in real values. Never commit .env.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=googlehora

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=43200

DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

FREE_QUESTIONS_INITIAL=5

# Ad network server-side verification (SSV) — see your ad network's docs
# (e.g. AdMob rewarded ads SSV) for the callback signature/public-key setup.
AD_SSV_SHARED_SECRET=

# Field-level encryption key for the most sensitive stored fields (exact
# birth time/coordinates, life event notes, chat message content) -- see
# app/field_encryption.py. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before storing/reading profile, life event, or message data --
# the app raises an error rather than silently falling back to plaintext
# if this is empty.
FIELD_ENCRYPTION_KEY=

# Full rectification runs allowed per user per day (each one calls every
# configured LLM provider).
RECTIFY_DAILY_LIMIT=100

# "dev" tolerates insecure defaults for local testing. Set to "prod" or
# "staging" anywhere else: the app then refuses to start unless
# JWT_SECRET, FIELD_ENCRYPTION_KEY, ALLOW_TEST_AD_BYPASS and
# LOG_LLM_PROMPTS are all set safely.
ENVIRONMENT=dev

# --- Optional tuning / rotation (all have defaults) ---
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_MODEL=gpt-4o-mini
# LLM_CHAT_TIMEOUT_SECONDS=30
# LLM_STRUCTURED_TIMEOUT_SECONDS=45
# Key rotation: new key in FIELD_ENCRYPTION_KEY, previous key(s) here
# (comma-separated), then run `python -m scripts.reencrypt_fields --apply`.
# FIELD_ENCRYPTION_OLD_KEYS=
