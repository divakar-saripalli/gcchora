# Copy to .env and fill in real values. Never commit .env.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=googlehora

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

FREE_QUESTIONS_INITIAL=5

# Ad network server-side verification (SSV) — see your ad network's docs
# (e.g. AdMob rewarded ads SSV) for the callback signature/public-key setup.
AD_SSV_SHARED_SECRET=
